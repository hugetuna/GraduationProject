#speaker:Kuma
#Tachie1_Character:Kuma #Tachie1_Emotion:Talk
#emotion:Talk
...哇。
#speaker:Kuma
#Tachie1_Character:Kuma #Tachie1_Emotion:Talk
#emotion:Talk
